# Local-only AO development settings. Never use DEV_AUTH_BYPASS in production.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Administrator identity used by the server-side role mapping.
ADMIN_EMAIL=bethmarieshanley6@gmail.com

# Local preview identity. Keep this aligned with ADMIN_EMAIL for admin preview testing.
DEV_AUTH_BYPASS=false
DEV_AUTH_USER_ID=dev-admin-bethmarieshanley6
DEV_AUTH_USER_NAME=Eliza Wood
DEV_AUTH_USER_EMAIL=bethmarieshanley6@gmail.com

# Required by the local session bypass. Generate a private local value.
JWT_SECRET=replace-with-a-local-only-secret

# Real OAuth/database values belong in the private environment, not this file.
# OAUTH_SERVER_URL=
# VITE_APP_ID=
# DATABASE_URL=
